<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Foxfire.Core\Foxfire.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

  <!--
    Microsoft.Data.SqlClient, under EF's SQL Server provider, still asks for
    System.Security.Cryptography.Pkcs 9.0.11, which carries two advisories
    (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). With warnings as errors that
    stops a restore, so the patched build is pinned here, beside the reference
    that drags the old one in. Every project that reads the database goes
    through this one, so the pin reaches them all. Drop it once SqlClient asks
    for a patched version itself.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>  </PropertyGroup>

</Project>
