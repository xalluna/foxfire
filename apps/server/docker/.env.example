# Foxfire Server configuration.
#
#   cp .env.example .env
#
# Fill in everything not marked optional. The server checks all of it at startup
# and refuses to run with a list of what is missing, rather than starting in a
# state where half the features quietly do not work.
#
# Generate each of the secrets below with:
#
#   openssl rand -base64 32
#
# Use a different value for each. Keep this file out of git — .env is ignored,
# .env.example is not.


# ── Where this server lives ──────────────────────────────────────────────────

# The address your friends reach this server at, exactly as they would type it.
# Invite links are built from it, and behind a reverse proxy the server cannot
# work this out for itself — every request arrives claiming to be for localhost.
#
# Must be https unless it is localhost. Passwords and account tokens travel over
# this, and the desktop refuses anything else.
SERVER_PUBLIC_URL=https://foxfire.example.com

# What your community calls itself. Shown on the connect screen and on invites.
SERVER_NAME=My Foxfire Server

# The port the server listens on, bound to localhost only. Point your reverse
# proxy at this; do not forward it.
#
# The server answers the API and the web client on this one port: your members
# open SERVER_PUBLIC_URL in a browser and get Foxfire, and the desktop app talks
# to the same address. Forward every path to it — the web client's pages, /api,
# and the WebSocket upgrade on /api/hub (and on /hub, which Foxfire desktop
# 0.12.0 still uses).
SERVER_PORT=8080


# ── Behind a reverse proxy (optional) ────────────────────────────────────────

# Sign-in, sign-up and search are rate limited per address. Behind a reverse
# proxy every request arrives from the proxy, so the server has to be told which
# proxies to believe when they say who a request was really from — otherwise
# the whole community counts as one address.
#
# The default trusts Docker's own networks, 172.16.0.0/12, and that is right
# for the setup this file describes: the port above is published on localhost
# only, so your proxy reaches the server through Docker's port forwarding and
# arrives from an address on one of those networks. Nothing outside the machine
# can connect directly, so nothing outside can claim to be a proxy.
#
# If you publish the port beyond localhost, set this to your proxy's address
# alone — anybody who can reach the port directly could otherwise write their
# own X-Forwarded-For and dodge the limits.
TRUSTED_PROXIES=
TRUSTED_PROXY_NETWORKS=172.16.0.0/12

# How many attempts one address gets per minute. Sign-in and sign-up share the
# first; the second is searches, which the finder sends as somebody types, so it
# is generous — a search reads this server's own tables rather than calling Riot.
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=120


# ── Who administers it ───────────────────────────────────────────────────────

# This address becomes a head admin the moment it registers, and stays one.
#
# A head admin is an admin who can also import a stats.db, type LP on anybody's
# account, and demote, disable, remove or make a reset link for another admin —
# plain admins can only promote people and let them back in. Head admins can make
# other people head admins from the Members page.
#
# Configured rather than given to whoever registers first, because public signup
# is on by default — a server that is reachable before you have got round to
# registering would otherwise belong to whoever found it. Registering with this
# address always works, even with signup shut, so you can never lock yourself
# out of your own server.
#
# It is also pinned: the account holding it cannot change its email in the app,
# nobody else can move onto it, and nobody can demote, disable or remove it from
# the app either. Handing the server over means changing it here and restarting.
#
# If you are the only head admin and you forget your password, there is nobody
# to make you a reset link — so this is the way back. Point this at a spare
# address, restart, and register it: that account is a head admin at once, and
# can make a reset link for your real one.
ADMIN_EMAIL=you@example.com

# How long a password reset link works for. Optional; the default is 24 hours.
#
# Far shorter than an invite's fortnight on purpose: an invite makes an account,
# a reset link takes one over. Accepts a .NET timespan — 24:00:00 is a day,
# 02:00:00 two hours.
#PASSWORD_RESET_LIFETIME=24:00:00


# ── Riot ─────────────────────────────────────────────────────────────────────

# Your key from https://developer.riotgames.com.
#
# One key serves everybody on this server. Read once at boot and never changed
# while running: rotating means editing this file and restarting. A *personal*
# key expires every 24 hours, so on one of those that is a daily chore — a
# production key, if you can get one approved, does not expire.
#
# While a key is refused, everything already stored still reads. What stops is
# fetching anything new.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# personal (20/s, 100 per 2 min) or application (500/10s, 30000/10 min).
#
# Almost certainly personal. Saying application when the key is not one only
# means collecting rate-limit errors faster. Note this is the allowance for the
# WHOLE server, not per person: ten friends share these hundred requests.
RIOT_KEY_TYPE=personal


# ── Secrets ──────────────────────────────────────────────────────────────────

# Signs the access tokens that keep people logged in.
# Changing it signs everybody out. Losing it means nobody can log in.
JWT_SIGNING_KEY=

# Signs invite links. A separate value on purpose, so leaking one does not leak
# both. Changing it invalidates every invite that has not been used yet.
INVITE_SIGNING_KEY=

# The SQL Server sa password. At least 8 characters with upper, lower and a
# digit or symbol, or SQL Server refuses to start and says very little about why.
MSSQL_SA_PASSWORD=

# Express is free to run for real and capped at 10 GB, which is a lot of League
# history — matches are stored once and shared by everybody here. Developer is
# free and uncapped but non-production only.
MSSQL_EDITION=Express


# ── Blob storage (optional until replay upload lands in Phase 3) ─────────────

# Left blank, this points at the Azurite container in docker-compose.yml, which
# speaks the real Azure Blob API with no cloud account and no credit card.
#
# To use actual Azure instead, put your storage account's connection string here
# and stop the blob service.
BLOB_CONNECTION_STRING=

# Where your friends' desktops reach the blob store.
#
# Replays never pass through the server: it hands the desktop a signed URL and
# the desktop uploads straight to the store. So this has to be an address that
# resolves on *their* machine, not on the server's — which is why it is a
# setting of its own rather than something read off the connection string.
#
# Left blank, it defaults to http://localhost:10000, which is right while you
# are trying the stack out on one machine and wrong the moment somebody else
# joins. Point it at the same hostname you used for SERVER_PUBLIC_URL, on the
# port below or through your reverse proxy:
#
#   BLOB_PUBLIC_URL=https://foxfire.example.com/blobs
#
# A path is allowed, for a proxy that strips it. Using real Azure instead of
# Azurite? Leave this blank — the account's own URL is already public.
#
# The web client downloads replays from here too, straight from the browser,
# and a browser will not download over plain http from a page served over
# https. So once SERVER_PUBLIC_URL is https, this should be as well.
BLOB_PUBLIC_URL=

# The port Azurite is published on. Only worth changing if 10000 is taken.
BLOB_PORT=


# ── Logs (optional) ──────────────────────────────────────────────────────────

# Logs go to the console — `docker compose logs server` — and are also kept in
# the blob store above, in a container called `logs`, one file an hour. That is
# on by default because the console's copy is gone the moment the container is
# recreated, which tends to be the moment after something went wrong.
#
# Every response carries an X-Trace-Id header. When somebody tells you a thing
# broke, that id finds every line the server wrote about it.

# Information is right for running. Debug is a great deal more, for chasing
# something down; Warning is only what needs looking at.
LOG_LEVEL=Information

# How long the blob store keeps logs, in days. 0 keeps them for good — for an
# Azure account whose own lifecycle policy already clears them out.
LOG_RETENTION_DAYS=30

# Keep logs somewhere other than the replay store: a storage account connection
# string of its own. Blank uses BLOB_CONNECTION_STRING's store.
LOG_CONNECTION_STRING=

# false stops keeping logs in the blob store, for a host sending them somewhere
# else instead. docker-compose.yml has ready-made blocks for a file on a volume,
# an OpenTelemetry collector, Seq and Application Insights — uncomment one.
LOG_TO_BLOB=true

# text for reading with your own eyes; json for a log collector reading the
# container's output for you (Grafana Alloy, Vector, the Datadog agent).
LOG_CONSOLE_FORMAT=text


# ── Insights (optional) ──────────────────────────────────────────────────────

# The server measures itself — every request it answers, every call to Riot,
# every sync, its CPU and memory — and an admin reads it on the Insights page,
# in the desktop app's Settings or the web client's admin tabs. Nothing leaves
# the server for it: the last hour is in memory, and history is kept in the
# database, a row a minute per series for two days and a row an hour after that.

# How many days of hourly history to keep. 0 keeps it for good. A month of a
# small community is tens of thousands of rows — small beside its match history.
INSIGHTS_RETENTION_DAYS=30


# ── Email (optional) ─────────────────────────────────────────────────────────

# Without it nothing is emailed, and nothing breaks: every invite and reset
# link is readable from the admin pages, in the desktop app or the web client,
# to copy into Discord. With it, those links are emailed as well, members can
# reset a forgotten password themselves from the sign-in page, new accounts are
# asked to confirm their address, and changing your address waits for the new
# one to confirm.
#
# Mail goes through one provider. The only one so far is Resend (resend.com):
#
#   1. Add and verify a domain there — a subdomain like mail.your-domain.gg is
#      the usual choice. Mail from an unverified domain is refused, and the
#      server holds everything until it is fixed.
#   2. Make an API key with "Sending access" only. It can do nothing else with
#      your account.
#   3. Optional but worth it: add a webhook pointing at
#        ${SERVER_PUBLIC_URL}/api/email/webhooks/resend
#      with the email.sent, delivered, delivery_delayed, bounced, complained,
#      failed and suppressed events ticked (not opened or clicked). Without it
#      mail is tracked as far as "sent" and a bounce goes unnoticed.
#
# Leave EMAIL_PROVIDER empty to send nothing.
EMAIL_PROVIDER=

# Where mail comes from — an address on the domain you verified. The name is
# this server's own (SERVER_NAME) unless you say otherwise.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# The server never sends more than your plan allows, so Resend never has to
# refuse it. The defaults are the free plan's: 100 a day (the UTC day) and
# 3,000 a month. On a paid plan, set the daily limit to 0 — there is none —
# and the monthly limit to your plan's, past which Resend charges per email.
#
# The count is the larger of what this server sent and what Resend says has
# gone — so anything else sending from the same Resend account counts too.
# Over a limit, mail waits and goes when the day or the month resets; a link
# that expires while it waits is not sent at all.
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000

# The day your monthly quota resets — your billing day, on Resend's usage page.
RESEND_MONTHLY_RESET_DAY=1

# The share of each day invites, test sends and new-account confirmations may
# use. The rest is kept for password resets and confirming a new address, so a
# batch of invites cannot leave somebody locked out until tomorrow.
EMAIL_INVITE_SHARE=0.8

# How many days the log of sent mail is kept. It holds members' addresses. At
# least 35 — the monthly limit is counted from it — or 0 for good.
EMAIL_RETENTION_DAYS=90
