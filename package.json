{
  "name": "foxfire-repo",
  "private": true,
  "description": "Foxfire monorepo: the desktop app, the Foxfire Server, and the packages they share",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @foxfire/desktop",
    "dev:web": "npm run dev:web -w @foxfire/desktop",
    "build": "npm run build -w @foxfire/desktop",
    "build:win": "npm run build:win -w @foxfire/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "tag-release": "node scripts/tag-release.mjs"
  }
}
